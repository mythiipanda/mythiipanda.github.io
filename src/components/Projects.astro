---
import { projects as all } from "../content";
import { url } from "../lib/url";
const rank = (p: { name: string }) => (p.name === "Dime" ? 1 : 0);
const projects = [...all].sort((a, b) => rank(b) - rank(a) || Number(b.dates) - Number(a.dates));
---
<section class="in" style="--i:3" aria-labelledby="h-proj">
  <h2 id="h-proj">Projects</h2>
  <ul class="rows">
    {projects.map((p) => (
      <li>
        <a class="row" href={p.url} target="_blank" rel="noreferrer" data-thumb={p.thumb && url(p.thumb)}>
          <span class="name">{p.name}<span class="arrow" aria-hidden="true">↗</span></span>
          <span class="meta">{p.dates}</span>
          <span class="what">{p.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
